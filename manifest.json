{
  "manifest_version": 3,
  "name": "Tab Auto Rename",
  "description": "Rename tab titles on selected sites using static names or URL placeholders.",
  "version": "0.1.0",
  "author": "calladot",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "tabs", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background/index.js"]
  },
  "action": {
    "default_area": "navbar", 
    "default_title": "Tab Auto Rename",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-autorename@calladot.dev",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "140.0"
    }
  }
}
